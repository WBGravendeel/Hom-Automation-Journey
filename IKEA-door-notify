blueprint:
  name: Door opened – notify phones
  description: >-
    Sends a push notification to selected phones when a door/contact sensor opens.
    Tapping the notification opens a chosen dashboard.
  domain: automation
  input:
    door_sensor:
      name: Door sensor(s)
      description: The IKEA (or any) door/contact sensor to watch.
      selector:
        entity:
          multiple: true
          filter:
            - domain: binary_sensor
              device_class:
                - door
                - opening
                - window
                - garage_door
    phones:
      name: Phones to notify
      description: Phones with the Home Assistant Companion app.
      selector:
        device:
          multiple: true
          filter:
            - integration: mobile_app
    dashboard:
      name: Dashboard to open on tap
      description: >-
        Path after your HA address, e.g. /lovelace/0 or /dashboard-security/doors
      default: /lovelace/0
      selector:
        text:
    title:
      name: Notification title
      default: Door opened
      selector:
        text:
    cooldown:
      name: Cooldown
      description: Ignore new openings for this long after a notification.
      default: 30
      selector:
        number:
          min: 0
          max: 600
          unit_of_measurement: seconds
          mode: box

mode: single
max_exceeded: silent

variables:
  phones: !input phones
  dashboard: !input dashboard
  title: !input title
  cooldown: !input cooldown

triggers:
  - trigger: state
    entity_id: !input door_sensor
    from: "off"
    to: "on"

actions:
  - repeat:
      for_each: "{{ phones }}"
      sequence:
        - action: "notify.mobile_app_{{ device_attr(repeat.item, 'name') | slugify }}"
          data:
            title: "{{ title }}"
            message: >-
              {{ state_attr(trigger.entity_id, 'friendly_name') }}
              opened at {{ now().strftime('%H:%M') }}
            data:
              tag: door-open
              url: "{{ dashboard }}"          # iPhone: open dashboard on tap
              clickAction: "{{ dashboard }}"  # Android: open dashboard on tap
              push:
                interruption-level: time-sensitive
              ttl: 0
              priority: high
  - delay:
      seconds: "{{ cooldown | int }}"
