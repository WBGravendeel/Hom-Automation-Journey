blueprint:
  name: Door Alert (Nobody Home) V2
  description: >
    Sends a notification when a door/contact sensor opens, and can record a
    short clip from one or more cameras.

    By default it only alerts when none of the selected people are home.
    You can also make it always alert, or always alert during a night-time
    window. Tapping the notification opens a chosen dashboard.
  domain: automation
  input:
    door_sensor:
      name: Door Sensor(s)
      description: The IKEA (or any) door/contact sensor to watch.
      selector:
        entity:
          multiple: true
          filter:
            - domain: binary_sensor
              device_class:
                - door
                - opening
                - window
                - garage_door

    people:
      name: People
      description: >
        The alert fires when ALL of these people are away from home.
        Not checked when "Always Alert" is on, or during the night window
        when "Always Alert at Night" is on. If left empty, everyone is
        treated as away and every opening alerts.
      default: []
      selector:
        entity:
          domain: person
          multiple: true

    always_alert:
      name: Always Alert
      description: Send notifications regardless of who is home.
      default: false
      selector:
        boolean: {}

    night_mode:
      name: Always Alert at Night
      description: >
        Send notifications regardless of who is home during the time
        window below.
      default: false
      selector:
        boolean: {}

    night_start:
      name: Night Window Start
      description: >
        Start of the night window. Can be before midnight.
        Note: 12:00 PM is noon, 12:00 AM is midnight.
      default: "22:00:00"
      selector:
        time: {}

    night_end:
      name: Night Window End
      description: End of the night window. Can be after midnight.
      default: "07:00:00"
      selector:
        time: {}

    phones:
      name: Phones to Notify
      description: >
        Only devices with the Home Assistant Companion App installed and
        logged in are listed.
      selector:
        device:
          multiple: true
          filter:
            - integration: mobile_app

    title:
      name: Notification Title
      default: Door opened
      selector:
        text: {}

    dashboard:
      name: Dashboard to Open on Tap
      description: >
        Path after your HA address, e.g. /lovelace/0 or /dashboard-security/doors
      default: /lovelace/0
      selector:
        text: {}

    cameras:
      name: Cameras to Record (optional)
      description: >
        Records a clip to the Media folder (Media → My media) when the door
        opens. Uses a separate stream, so it does not interrupt recording the
        camera or your NVR is already doing. Leave empty to skip recording.
      default: []
      selector:
        entity:
          domain: camera
          multiple: true

    clip_folder:
      name: Recording Folder
      description: >
        Where clips are saved, e.g. /media or /media/door_clips. Folders
        under /media show up in Media → My media. Any other location must be
        listed under allowlist_external_dirs in configuration.yaml.
      default: /media
      selector:
        text: {}

    clip_duration:
      name: Clip Length
      default: 30
      selector:
        number:
          min: 5
          max: 300
          unit_of_measurement: seconds
          mode: box

    clip_lookback:
      name: Clip Lookback
      description: >
        Seconds of footage from before the door opened to include. Only works
        if "Preload stream" is enabled in the camera entity's settings.
      default: 5
      selector:
        number:
          min: 0
          max: 30
          unit_of_measurement: seconds
          mode: box

    record_always:
      name: Record Even When Not Alerting
      description: >
        Off: only record when a notification is sent.
        On: record every time the door opens, even when someone is home.
      default: false
      selector:
        boolean: {}

    cooldown:
      name: Cooldown
      description: Ignore new openings for this long after a trigger.
      default: 30
      selector:
        number:
          min: 0
          max: 600
          unit_of_measurement: seconds
          mode: box

mode: single
max_exceeded: silent

variables:
  people: !input people
  always_alert: !input always_alert
  night_mode: !input night_mode
  night_start: !input night_start
  night_end: !input night_end
  phones: !input phones
  title: !input title
  dashboard: !input dashboard
  cameras: !input cameras
  clip_folder: !input clip_folder
  clip_duration: !input clip_duration
  clip_lookback: !input clip_lookback
  record_always: !input record_always
  cooldown: !input cooldown
  is_night: >-
    {% set t = now().strftime('%H:%M:%S') %}
    {% if night_start <= night_end %}
      {{ night_start <= t < night_end }}
    {% else %}
      {{ t >= night_start or t < night_end }}
    {% endif %}
  nobody_home: >-
    {{ people | select('is_state', 'home') | list | count == 0 }}
  should_alert: >-
    {{ always_alert or (night_mode and is_night) or nobody_home }}
  should_record: >-
    {{ cameras | count > 0 and (should_alert or record_always) }}
  stamp: "{{ now().strftime('%Y%m%d_%H%M%S') }}"

triggers:
  - trigger: state
    entity_id: !input door_sensor
    from: "off"
    to: "on"

conditions:
  - condition: template
    value_template: "{{ should_alert or should_record }}"

actions:
  # 1. Start the clip(s) first so nothing is missed
  - if:
      - condition: template
        value_template: "{{ should_record }}"
    then:
      - repeat:
          for_each: "{{ cameras }}"
          sequence:
            - action: camera.record
              continue_on_error: true   # a camera failure won't block the alert
              target:
                entity_id: "{{ repeat.item }}"
              data:
                filename: >-
                  {{ clip_folder | trim | regex_replace('/+$', '') }}/door_{{ repeat.item | replace('camera.', '') }}_{{ stamp }}.mp4
                duration: "{{ clip_duration | int }}"
                lookback: "{{ clip_lookback | int }}"

  # 2. Notify the phones
  - if:
      - condition: template
        value_template: "{{ should_alert }}"
    then:
      - repeat:
          for_each: "{{ phones }}"
          sequence:
            - action: "notify.mobile_app_{{ device_attr(repeat.item, 'name') | slugify }}"
              data:
                title: "{{ title }}"
                message: >-
                  {{ state_attr(trigger.entity_id, 'friendly_name') }}
                  opened at {{ now().strftime('%H:%M') }}
                data:
                  tag: door-open
                  url: "{{ dashboard }}"          # iPhone: open dashboard on tap
                  clickAction: "{{ dashboard }}"  # Android: open dashboard on tap
                  push:
                    interruption-level: time-sensitive
                  ttl: 0
                  priority: high

  # 3. Cooldown
  - if:
      - condition: template
        value_template: "{{ cooldown | int(0) > 0 }}"
    then:
      - delay:
          seconds: "{{ cooldown | int(0) }}"
